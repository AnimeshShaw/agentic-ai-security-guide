---
import '../styles/global.css';
import SearchModal from '../components/SearchModal.astro';

export interface Props {
  title: string;
  description?: string;
  /** Optional canonical URL override — defaults to current page URL */
  canonical?: string;
  /** Optional Open Graph image URL */
  ogImage?: string;
}

const {
  title,
  description = 'The leadership guide to agentic AI security — for CISOs, CTOs, and board members. Covers OWASP LLM Top 10, Agentic AI Top 10, governance frameworks, compliance, and a 12-month action plan.',
  canonical,
  ogImage,
} = Astro.props;

const pageTitle = title === 'Home'
  ? 'Agentic AI Security Guide — Executive & Technical Handbook'
  : `${title} — Agentic AI Security Guide`;

const siteUrl = 'https://animeshshaw.github.io/agentic-ai-security-guide';
const canonicalUrl = canonical ?? (siteUrl + Astro.url.pathname);
const defaultOgImage = `${siteUrl}/og-cover.png`;
const resolvedOgImage = ogImage ?? defaultOgImage;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Animesh Shaw" />
    <meta name="keywords" content="agentic AI security, LLM security, OWASP LLM Top 10, AI governance, AI risk management, prompt injection, CISO AI guide, autonomous agents security, AI compliance" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:site_name" content="Agentic AI Security Guide" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:creator" content="@AnimeshShaw" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": title === 'Home' ? "WebSite" : "Article",
      "name": pageTitle,
      "description": description,
      "url": canonicalUrl,
      "author": {
        "@type": "Person",
        "name": "Animesh Shaw",
        "url": "https://github.com/AnimeshShaw"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Agentic AI Security Guide",
        "url": siteUrl
      },
      ...(title === 'Home' ? {
        "potentialAction": {
          "@type": "SearchAction",
          "target": `${siteUrl}/?q={search_term_string}`,
          "query-input": "required name=search_term_string"
        }
      } : {})
    })} />

    <!-- Apply saved theme before first paint to prevent flash -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <div id="reading-progress"></div>
    <slot />
    <SearchModal />

    <script is:inline>
      // Reading progress bar listener
      var bar = document.getElementById('reading-progress');
      if (bar) {
        var update = function () {
          var scrolled = window.scrollY;
          var total = document.documentElement.scrollHeight - window.innerHeight;
          bar.style.width = total > 0 ? (scrolled / total) * 100 + '%' : '0%';
        };
        window.addEventListener('scroll', update, { passive: true });
        update();
      }

      // Add copy button to code blocks
      document.addEventListener('DOMContentLoaded', function() {
        var preBlocks = document.querySelectorAll('pre');
        preBlocks.forEach(function(pre) {
          if (pre.parentNode.classList.contains('code-block-wrapper')) return;
          
          var wrapper = document.createElement('div');
          wrapper.className = 'code-block-wrapper';
          
          var header = document.createElement('div');
          header.className = 'code-block-header';
          header.innerHTML = '<span>Code Example</span><button class="copy-code-btn">Copy</button>';
          
          pre.parentNode.insertBefore(wrapper, pre);
          wrapper.appendChild(header);
          wrapper.appendChild(pre);

          var btn = header.querySelector('.copy-code-btn');
          if (btn) {
            btn.addEventListener('click', function() {
              var code = pre.querySelector('code') || pre;
              navigator.clipboard.writeText(code.textContent || '').then(function() {
                btn.textContent = 'Copied!';
                setTimeout(function() { btn.textContent = 'Copy'; }, 2000);
              });
            });
          }
        });
      });
    </script>
  </body>
</html>
