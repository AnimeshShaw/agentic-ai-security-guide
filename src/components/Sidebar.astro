---
import { navigation } from '../data/nav';

export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const normalizedPath = currentPath.replace(/\/$/, '') || '/';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-inner">

    <!-- Brand -->
    <div class="sidebar-brand">
      <a href={base + '/'} class="brand-link">
        <svg class="brand-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M16 2L4 7V17C4 23.627 9.373 29 16 30C22.627 29 28 23.627 28 17V7L16 2Z" fill="currentColor" fill-opacity="0.12" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
          <path d="M11 16L14.5 19.5L21 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div class="brand-text">
          <span class="brand-title">Agentic Security</span>
          <span class="brand-sub">Executive Guide</span>
        </div>
      </a>
    </div>

    <!-- Quick Search trigger in Sidebar -->
    <div class="sidebar-search">
      <button class="sidebar-search-btn" data-open-search aria-label="Open Search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span>Search topics...</span>
        <kbd>⌘K</kbd>
      </button>
    </div>

    <!-- Navigation -->
    <nav class="sidebar-nav" aria-label="Site navigation">
      {navigation.map((section) => {
        const hasActiveChild = section.items.some((i) => normalizedPath === i.href);
        return (
          <div class="nav-section">
            <div class="nav-section-title">{section.title}</div>
            <ul class="nav-items">
              {section.items.map((item) => {
                const isActive = normalizedPath === item.href;
                return (
                  <li>
                    <a
                      href={base + item.href}
                      class:list={['nav-item', { active: isActive }]}
                      aria-current={isActive ? 'page' : undefined}
                    >
                      {item.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })}
    </nav>

  </div>

  <!-- Theme toggle footer -->
  <div class="sidebar-footer">
    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
      <!-- Sun icon -->
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
      </svg>
      <!-- Moon icon -->
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
      <span class="theme-label">Toggle theme</span>
    </button>
  </div>
</aside>

<button class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle navigation">
  <span></span><span></span><span></span>
</button>

<style>
  /* ── Sidebar Shell ─────────────────────────────────────────── */
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-width);
    height: 100vh;
    background: var(--surface);
    border-right: 1px solid var(--border);
    overflow-y: auto;
    z-index: 50;
    display: flex;
    flex-direction: column;
    /* Scan-line top accent */
    border-top: 2px solid var(--accent);
  }

  .sidebar-inner {
    padding: 0 0 1rem;
    flex: 1;
  }

  /* ── Brand ─────────────────────────────────────────────────── */
  .sidebar-brand {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--surface);
    z-index: 1;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
  }

  .brand-icon {
    width: 26px;
    height: 26px;
    color: var(--accent);
    flex-shrink: 0;
  }

  .brand-text { display: flex; flex-direction: column; }

  .brand-title {
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 1px;
  }

  /* ── Search ────────────────────────────────────────────────── */
  .sidebar-search {
    padding: 0.75rem 1rem 0.375rem;
  }

  .sidebar-search-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.42rem 0.75rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.78rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .sidebar-search-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sidebar-search-btn kbd {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    padding: 0.08rem 0.28rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 3px;
  }

  /* ── Navigation ────────────────────────────────────────────── */
  .sidebar-nav { padding: 0.5rem 0; }

  .nav-section { margin-bottom: 0.25rem; }

  .nav-section-title {
    padding: 0.65rem 1.25rem 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }

  .nav-items { list-style: none; padding: 0; margin: 0; }

  .nav-item {
    display: block;
    padding: 0.38rem 1.25rem 0.38rem 1.6rem;
    font-size: 0.82rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color 0.12s ease, background 0.12s ease, border-color 0.12s ease;
    line-height: 1.4;
  }

  .nav-item:hover {
    color: var(--text-primary);
    background: var(--bg);
    border-left-color: var(--border-strong);
    text-decoration: none;
  }

  .nav-item.active {
    color: var(--accent);
    background: var(--accent-bg);
    border-left-color: var(--accent);
    font-weight: 600;
  }

  /* ── Footer ────────────────────────────────────────────────── */
  .sidebar-footer {
    padding: 0.875rem 1.25rem;
    border-top: 1px solid var(--border);
    background: var(--surface);
    position: sticky;
    bottom: 0;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.48rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition);
  }

  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .theme-toggle svg { width: 14px; height: 14px; flex-shrink: 0; }

  .icon-sun { display: none; }
  .icon-moon { display: block; }
  html.dark .icon-sun { display: block; }
  html.dark .icon-moon { display: none; }

  /* ── Mobile Toggle ─────────────────────────────────────────── */
  .sidebar-toggle {
    display: none;
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    background: var(--accent);
    border: none;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    z-index: 100;
    box-shadow: var(--shadow-lg), 0 0 0 4px var(--accent-glow);
  }

  .sidebar-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    background: #000;
    border-radius: 1px;
  }

  @media (max-width: 768px) {
    .sidebar {
      transform: translateX(-100%);
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .sidebar.open { transform: translateX(0); }
    .sidebar-toggle { display: flex; }
  }
</style>

<script>
  // Mobile sidebar toggle
  const toggle = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('sidebar');
  if (toggle && sidebar) {
    toggle.addEventListener('click', () => sidebar.classList.toggle('open'));
    document.addEventListener('click', (e) => {
      if (!sidebar.contains(e.target as Node) && !toggle.contains(e.target as Node)) {
        sidebar.classList.remove('open');
      }
    });
  }

  // Dark mode toggle
  const themeBtn = document.getElementById('theme-toggle');
  const label = themeBtn?.querySelector('.theme-label');

  function applyTheme(dark: boolean) {
    document.documentElement.classList.toggle('dark', dark);
    localStorage.setItem('theme', dark ? 'dark' : 'light');
    if (label) label.textContent = dark ? 'Light mode' : 'Dark mode';
  }

  const isDark = document.documentElement.classList.contains('dark');
  if (label) label.textContent = isDark ? 'Light mode' : 'Dark mode';

  themeBtn?.addEventListener('click', () => {
    applyTheme(!document.documentElement.classList.contains('dark'));
  });
</script>
