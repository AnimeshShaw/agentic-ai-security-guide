---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import ThreatMatrix from '../components/ThreatMatrix.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!--
  THESIS: A cold, authoritative threat-intelligence platform — not a SaaS marketing page.
  The visual language is derived from SIEM dashboards and incident-response tooling.
  OWN-WORLD: Near-black canvas (#080C14), cold zinc neutrals, electric cyan accent.
  Geist display + Geist Mono. Corner radius: 6px. No gradient text. No eyebrows.
  STORY: Visitor understands the scope of agentic AI risk, selects their role, and enters the guide.
  FIRST VIEWPORT: Left-aligned headline (no eyebrow), right: live threat console panel.
  FORM: Threat Console direction — security intelligence tool aesthetic.
  FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->
<BaseLayout title="Home">
  <div class="site-wrapper">
    <Sidebar currentPath="/" />
    <main class="home-main fade-in">

      <!-- ── Hero ──────────────────────────────────────────────── -->
      <section class="hero">
        <div class="hero-inner">
          <div class="hero-copy">
            <div class="hero-label">
              <span class="scan-dot" aria-hidden="true"></span>
              <span>Agentic AI Security · 2025–2026 Edition</span>
            </div>

            <h1 class="hero-h1">
              Autonomous agents execute.<br/>
              <span class="hero-h1-dim">What stops them from<br/>executing the wrong thing?</span>
            </h1>

            <p class="hero-p">
              The definitive governance handbook for CISOs, CTOs, and risk leaders. From prompt injection to rogue agents — every threat explained, every control mapped.
            </p>

            <div class="hero-actions">
              <a href={base + "/foundations/what-is-agentic-ai"} class="btn-primary">
                Start Reading
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href={base + "/governance/leadership-checklist"} class="btn-ghost">
                50-Point Audit Checklist
              </a>
            </div>

            <dl class="hero-stats">
              <div class="hero-stat">
                <dt>40+</dt>
                <dd>In-depth pages</dd>
              </div>
              <div class="hero-stat">
                <dt>20</dt>
                <dd>Mapped threats</dd>
              </div>
              <div class="hero-stat">
                <dt>50</dt>
                <dd>Audit checklist items</dd>
              </div>
              <div class="hero-stat">
                <dt>100%</dt>
                <dd>Vendor-neutral</dd>
              </div>
            </dl>
          </div>

          <!-- Threat console panel — real content, not decorative -->
          <div class="console-panel" aria-label="Sample threat intelligence panel">
            <div class="console-header">
              <span class="console-title">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                Active Threat Indicators
              </span>
              <span class="console-live">
                <span class="live-dot" aria-hidden="true"></span>
                LIVE
              </span>
            </div>
            <div class="console-body">
              <a href={base + "/llm-top-10/prompt-injection"} class="console-row console-row--critical">
                <span class="console-sev">CRITICAL</span>
                <span class="console-id">LLM01</span>
                <span class="console-name">Prompt Injection</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href={base + "/agentic-top-10/agent-goal-hijack"} class="console-row console-row--critical">
                <span class="console-sev">CRITICAL</span>
                <span class="console-id">ASI01</span>
                <span class="console-name">Agent Goal Hijack</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href={base + "/llm-top-10/supply-chain"} class="console-row console-row--high">
                <span class="console-sev">HIGH</span>
                <span class="console-id">LLM03</span>
                <span class="console-name">Supply Chain Risks</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href={base + "/agentic-top-10/memory-poisoning"} class="console-row console-row--high">
                <span class="console-sev">HIGH</span>
                <span class="console-id">ASI05</span>
                <span class="console-name">Memory Poisoning</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href={base + "/agentic-top-10/supply-chain"} class="console-row console-row--high">
                <span class="console-sev">HIGH</span>
                <span class="console-id">ASI04</span>
                <span class="console-name">MCP Tool Hijacking</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href={base + "/llm-top-10/misinformation"} class="console-row console-row--medium">
                <span class="console-sev">MEDIUM</span>
                <span class="console-id">LLM09</span>
                <span class="console-name">Misinformation</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
            <div class="console-footer">
              <a href={base + "/llm-top-10"} class="console-footer-link">View all 20 threats →</a>
              <button class="console-search-btn" data-open-search>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                Search ⌘K
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Role Selector ──────────────────────────────────────── -->
      <section class="role-section">
        <div class="section-wrap">
          <div class="role-header">
            <h2 class="section-h2">Select your role</h2>
            <p class="section-p">Tailored reading paths for each leadership function — jump directly to what matters most for your responsibility area.</p>
          </div>

          <div class="role-ui">
            <div class="role-tabs" role="tablist" aria-label="Role-based reading paths">
              <button class="role-tab active" data-role="ciso" role="tab" aria-selected="true">CISO / Security VP</button>
              <button class="role-tab" data-role="cto" role="tab" aria-selected="false">CTO / CIO</button>
              <button class="role-tab" data-role="board" role="tab" aria-selected="false">Board Member</button>
              <button class="role-tab" data-role="risk" role="tab" aria-selected="false">Risk Officer</button>
              <button class="role-tab" data-role="vendor" role="tab" aria-selected="false">Procurement</button>
            </div>

            <div class="role-panel" id="role-content" role="tabpanel">
              <!-- Rendered by inline script -->
            </div>
          </div>
        </div>
      </section>

      <!-- ── Threat Matrix ────────────────────────────────────── -->
      <section class="matrix-section">
        <div class="section-wrap">
          <h2 class="section-h2">OWASP LLM & Agentic Security Risk Matrix</h2>
          <p class="section-p">All 20 canonical AI vulnerabilities — categorized by attack domain and severity. Click any entry to read the full breakdown.</p>
          <ThreatMatrix />
        </div>
      </section>

      <!-- ── Guide Index ──────────────────────────────────────── -->
      <section class="guide-index">
        <div class="section-wrap">
          <h2 class="section-h2">Full Guide Overview</h2>
          <div class="guide-grid">

            <article class="guide-part">
              <div class="guide-part-label">
                <span class="mono-tag">[F]</span>
                <span>Part 1 — Foundations</span>
              </div>
              <p class="guide-part-desc">What agentic AI actually is. How it works under the hood. Why the security risk is categorically different from classic LLM chatbots.</p>
              <ul class="guide-links">
                <li><a href={base + "/foundations/what-is-agentic-ai"}>What is Agentic AI?</a></li>
                <li><a href={base + "/foundations/how-agents-work"}>How Agents Work</a></li>
                <li><a href={base + "/foundations/why-security-matters"}>Why Security Matters</a></li>
              </ul>
            </article>

            <article class="guide-part guide-part--threat">
              <div class="guide-part-label">
                <span class="mono-tag mono-tag--danger">[T]</span>
                <span>Part 2 — Threat Landscape</span>
              </div>
              <p class="guide-part-desc">Where agents are vulnerable. Prompt injection explained plainly. Real incidents that have already happened in the wild.</p>
              <ul class="guide-links">
                <li><a href={base + "/threats/attack-surface"}>Attack Surface</a></li>
                <li><a href={base + "/threats/prompt-injection"}>Prompt Injection</a></li>
                <li><a href={base + "/threats/real-world-incidents"}>Real-World Incidents</a></li>
              </ul>
            </article>

            <article class="guide-part guide-part--owasp">
              <div class="guide-part-label">
                <span class="mono-tag mono-tag--accent">[O]</span>
                <span>OWASP LLM Top 10</span>
              </div>
              <p class="guide-part-desc">The official OWASP top 10 vulnerabilities for large language models — every one explained with interactive examples.</p>
              <ul class="guide-links">
                <li><a href={base + "/llm-top-10"}>Explore OWASP LLM Top 10 →</a></li>
              </ul>
            </article>

            <article class="guide-part guide-part--agentic">
              <div class="guide-part-label">
                <span class="mono-tag mono-tag--accent">[A]</span>
                <span>Agentic AI Top 10</span>
              </div>
              <p class="guide-part-desc">The 10 critical risks unique to autonomous agents — from memory poisoning to runaway action loops.</p>
              <ul class="guide-links">
                <li><a href={base + "/agentic-top-10"}>Explore Agentic AI Top 10 →</a></li>
              </ul>
            </article>

            <article class="guide-part">
              <div class="guide-part-label">
                <span class="mono-tag">[C]</span>
                <span>Part 3 — Core Technologies</span>
              </div>
              <p class="guide-part-desc">MCP, LiteLLM, NeMo Guardrails, sandboxing — the tools that exist to protect agentic systems, explained for implementers.</p>
              <ul class="guide-links">
                <li><a href={base + "/technologies/mcp-protocol"}>MCP Protocol</a></li>
                <li><a href={base + "/technologies/litellm-proxy"}>LiteLLM Proxy</a></li>
                <li><a href={base + "/technologies/nemo-guardrails"}>NeMo Guardrails</a></li>
                <li><a href={base + "/technologies/sandboxing"}>Sandboxing Agents</a></li>
              </ul>
            </article>

            <article class="guide-part">
              <div class="guide-part-label">
                <span class="mono-tag">[G]</span>
                <span>Part 4 — Governance</span>
              </div>
              <p class="guide-part-desc">NIST AI RMF, EU AI Act, ISO 42001. What you must govern. 50 questions every security leader should be asking today.</p>
              <ul class="guide-links">
                <li><a href={base + "/governance/compliance-frameworks"}>Compliance Frameworks</a></li>
                <li><a href={base + "/governance/leadership-checklist"}>Interactive Readiness Checklist</a></li>
              </ul>
            </article>

          </div>
        </div>
      </section>

      <!-- ── Bottom CTA ───────────────────────────────────────── -->
      <section class="bottom-cta">
        <div class="bottom-cta-inner">
          <p class="cta-pre">Ready to govern autonomous AI in your organization?</p>
          <h2 class="cta-h2">Start with foundations or run the 50-point readiness audit.</h2>
          <div class="cta-actions">
            <a href={base + "/foundations/what-is-agentic-ai"} class="btn-primary btn-primary--lg">
              Begin Part 1
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href={base + "/governance/leadership-checklist"} class="btn-ghost">Run Readiness Check</a>
          </div>
        </div>
      </section>

    </main>
  </div>
</BaseLayout>

<style>
  .home-main {
    flex: 1;
    margin-left: var(--sidebar-width);
  }

  @media (max-width: 768px) {
    .home-main { margin-left: 0; }
  }

  /* ── Shared Section Wrapper ──────────────────────────────── */
  .section-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 3rem;
  }

  @media (max-width: 768px) {
    .section-wrap { padding: 0 1.25rem; }
  }

  .section-h2 {
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 0.6rem;
    margin-top: 0;
  }

  .section-p {
    color: var(--text-secondary);
    font-size: 1rem;
    max-width: 60ch;
    margin-bottom: 0;
  }

  /* ── Buttons ─────────────────────────────────────────────── */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.5rem;
    background: var(--accent);
    color: #000;
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 0.9rem;
    transition: all var(--transition);
    text-decoration: none;
    border: none;
    cursor: pointer;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px var(--accent-glow);
    text-decoration: none;
    color: #000;
  }

  .btn-primary--lg {
    padding: 0.85rem 2rem;
    font-size: 0.95rem;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.4rem;
    background: transparent;
    color: var(--zone-text-secondary);
    border: 1px solid var(--zone-border-2);
    border-radius: var(--radius);
    font-weight: 500;
    font-size: 0.9rem;
    transition: all var(--transition);
    text-decoration: none;
  }

  .btn-ghost:hover {
    border-color: var(--zone-accent);
    color: var(--zone-accent);
    text-decoration: none;
  }

  /* ── Hero ────────────────────────────────────────────────── */
  .hero {
    background: var(--zone-bg);
    color: var(--zone-text);
    padding: 4.5rem 3rem 4rem;
    border-bottom: 1px solid var(--zone-border);
    position: relative;
    overflow: hidden;
  }

  /* Scan-line top bar — single, disciplined accent use */
  .hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--zone-accent);
    opacity: 0.9;
  }

  /* Subtle ambient glow — restrained, not AI-blob */
  .hero::after {
    content: '';
    position: absolute;
    bottom: -60px;
    right: -60px;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(0,212,255,0.05) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  /* ── Hero Copy ───────────────────────────────────────────── */
  .hero-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--zone-accent);
    letter-spacing: 0.04em;
    margin-bottom: 1.5rem;
  }

  .scan-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--zone-accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .hero-h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--zone-text);
    margin-bottom: 1.25rem;
  }

  .hero-h1-dim {
    color: var(--zone-text-secondary);
  }

  .hero-p {
    font-size: 1.05rem;
    color: var(--zone-text-secondary);
    line-height: 1.7;
    max-width: 52ch;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .hero-stats {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    padding-top: 1.75rem;
    border-top: 1px solid var(--zone-border);
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .hero-stat dt {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--zone-text);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero-stat dd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--zone-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ── Console Panel ───────────────────────────────────────── */
  .console-panel {
    background: var(--zone-surface);
    border: 1px solid var(--zone-border-2);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 24px 48px rgba(0,0,0,0.5), 0 0 0 1px rgba(0,212,255,0.06);
  }

  .console-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--zone-surface-2);
    border-bottom: 1px solid var(--zone-border);
  }

  .console-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--zone-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .console-live {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: #4ADE80;
    letter-spacing: 0.08em;
  }

  .live-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #4ADE80;
    animation: pulse 1.5s ease-in-out infinite;
  }

  .console-body {
    padding: 0.375rem 0;
  }

  .console-row {
    display: grid;
    grid-template-columns: 62px 48px 1fr 16px;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-left: 2px solid transparent;
    text-decoration: none;
    transition: background 0.12s ease, border-color 0.12s ease;
  }

  .console-row:hover {
    background: rgba(255,255,255,0.03);
    text-decoration: none;
  }

  .console-row svg { color: var(--zone-text-muted); opacity: 0; transition: opacity 0.12s ease; }
  .console-row:hover svg { opacity: 1; color: var(--zone-accent); }

  .console-row--critical { border-left-color: #E53935; }
  .console-row--high     { border-left-color: #F57C00; }
  .console-row--medium   { border-left-color: #EAB308; }

  .console-sev {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .console-row--critical .console-sev { color: #EF5350; }
  .console-row--high .console-sev     { color: #FF7043; }
  .console-row--medium .console-sev   { color: #FDD835; }

  .console-id {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--zone-accent);
    font-weight: 600;
  }

  .console-name {
    font-size: 0.8rem;
    color: var(--zone-text);
    font-weight: 500;
  }

  .console-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    border-top: 1px solid var(--zone-border);
    background: var(--zone-surface-2);
  }

  .console-footer-link {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--zone-accent);
    text-decoration: none;
  }

  .console-footer-link:hover {
    text-decoration: underline;
  }

  .console-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    background: transparent;
    border: 1px solid var(--zone-border-2);
    border-radius: var(--radius-sm);
    color: var(--zone-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .console-search-btn:hover {
    border-color: var(--zone-accent);
    color: var(--zone-accent);
  }

  @media (max-width: 960px) {
    .hero { padding: 3.5rem 1.5rem 3rem; }
    .hero-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .console-panel { max-width: 100%; }
  }

  @media (max-width: 640px) {
    .hero-stats { gap: 1.5rem; }
    .hero-actions { flex-direction: column; align-items: flex-start; }
  }

  /* ── Role Selector ───────────────────────────────────────── */
  .role-section {
    padding: 4rem 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .role-header {
    margin-bottom: 2rem;
  }

  .role-ui {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .role-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .role-tabs::-webkit-scrollbar { display: none; }

  .role-tab {
    flex-shrink: 0;
    padding: 0.65rem 1.2rem;
    font-size: 0.82rem;
    font-weight: 600;
    border: none;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .role-tab:hover {
    color: var(--text-primary);
    background: var(--surface-2);
  }

  .role-tab.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
    background: transparent;
  }

  .role-panel {
    padding: 1.75rem 2rem;
  }

  @media (max-width: 768px) {
    .role-section { padding: 3rem 0; }
