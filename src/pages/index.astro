<script is:inline define:vars={{ baseUrl: base }}>
  (function() {
    var roleData = {
      ciso: {
        title: 'CISO & Security VP Reading Path',
        time: '3–4 hours',
        desc: 'Strategic risk assessment, OWASP LLM vs Agentic threat taxonomy, supply chain posture, and governance frameworks.',
        steps: [
          { id: '01', name: 'Threat Landscape & Attack Surface', href: '/threats/attack-surface' },
          { id: '02', name: 'Agentic AI Top 10 Deep Dive', href: '/agentic-top-10' },
          { id: '03', name: 'Compliance & Framework Mapping (NIST, EU AI Act, ISO 42001)', href: '/governance/compliance-frameworks' },
          { id: '04', name: 'Executive Leadership Checklist & Readiness Score', href: '/governance/leadership-checklist' }
        ]
      },
      cto: {
        title: 'CTO, CIO & System Architect Reading Path',
        time: '2 hours',
        desc: 'Runtime isolation, sandboxing architecture, API gateway control, and MCP (Model Context Protocol) tool integration.',
        steps: [
          { id: '01', name: 'How Agents Work Under the Hood', href: '/foundations/how-agents-work' },
          { id: '02', name: 'Model Context Protocol (MCP) Security Specs', href: '/technologies/mcp-protocol' },
          { id: '03', name: 'Sandboxing Agentic Execution (eBPF, Wasm, microVMs)', href: '/technologies/sandboxing' },
          { id: '04', name: '12-Month Technology Implementation Roadmap', href: '/future/action-plan' }
        ]
      },
      board: {
        title: 'Board Member & C-Suite Reading Path',
        time: '30 minutes',
        desc: 'High-level orientation on why autonomous agentic security differs from classic LLM chatbots and key fiduciary responsibilities.',
        steps: [
          { id: '01', name: 'What is Agentic AI & Executive Summary', href: '/foundations/what-is-agentic-ai' },
          { id: '02', name: 'Why Security Matters for Autonomous AI', href: '/foundations/why-security-matters' },
          { id: '03', name: 'Leadership Assessment Checklist', href: '/governance/leadership-checklist' }
        ]
      },
      risk: {
        title: 'Risk Officer & Compliance Manager Reading Path',
        time: '90 minutes',
        desc: 'Regulatory obligations, EU AI Act enforcement tiers, audit logging, and risk mitigation checklists.',
        steps: [
          { id: '01', name: 'AI Governance Basics & Risk Allocation', href: '/governance/ai-governance-basics' },
          { id: '02', name: 'Compliance Frameworks (NIST AI RMF 1.0 & ISO 42001)', href: '/governance/compliance-frameworks' },
          { id: '03', name: 'Interactive Risk Maturity Score Calculator', href: '/governance/leadership-checklist' }
        ]
      },
      vendor: {
        title: 'Procurement & Third-Party Evaluator Reading Path',
        time: '45 minutes',
        desc: 'Third-party tool permissions, supply chain vulnerabilities, and vendor security verification.',
        steps: [
          { id: '01', name: 'LLM Supply Chain Risks (LLM03)', href: '/llm-top-10/supply-chain' },
          { id: '02', name: 'Agentic Tool & MCP Supply Chain (ASI04)', href: '/agentic-top-10/supply-chain' },
          { id: '03', name: 'Vendor AI Security Review Guidelines', href: '/governance/ai-governance-basics' }
        ]
      }
    };

    var tabs = document.querySelectorAll('.role-tab');
    var panel = document.getElementById('role-content');

    function render(roleKey) {
      var d = roleData[roleKey] || roleData.ciso;
      if (!panel) return;

      var stepsHtml = d.steps.map(function(s) {
        return '<a href="' + baseUrl + s.href + '" class="role-step">' +
          '<span class="role-step-id">' + s.id + '</span>' +
          '<span class="role-step-name">' + s.name + '</span>' +
          '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>' +
        '</a>';
      }).join('');

      panel.innerHTML =
        '<div class="role-panel-header">' +
          '<div class="role-panel-title">' + d.title + '</div>' +
          '<div class="role-panel-meta">' +
            '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>' +
            d.time +
          '</div>' +
        '</div>' +
        '<p class="role-panel-desc">' + d.desc + '</p>' +
        '<div class="role-steps">' + stepsHtml + '</div>';
    }

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        render(tab.getAttribute('data-role') || 'ciso');
      });
    });

    render('ciso');
  })();
</script>

